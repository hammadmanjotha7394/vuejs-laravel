<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Block direct web access to sensitive root files
    RewriteRule ^(\.env|artisan|composer\.(json|lock)|phpunit\.xml|\.git) - [F,L,NC]

    # Route all requests into the public/ directory (serves Vue /app/ assets + Laravel API)
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
